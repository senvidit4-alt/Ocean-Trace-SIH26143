# =============================================================================
# OceanTrace Environment Configuration Template
# =============================================================================
# Copy this file to .env before deploying or running in production:
#   cp .env.example .env
#
# NOTE: These represent the runtime settings and paths currently used by the 
# pipeline and FastAPI backend.

# -----------------------------------------------------------------------------
# Server & Network Configuration
# -----------------------------------------------------------------------------
# Host to bind the FastAPI/Uvicorn server (0.0.0.0 for cloud containers)
HOST=0.0.0.0

# Server port (Render/Railway injects $PORT automatically)
PORT=8000

# Allowed CORS origins (comma-separated). Set to specific frontend URL in production
# Example: https://oceantrace.vercel.app,http://localhost:3000,http://localhost:5173
CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# Model & AI Weights (Module 1 Detection)
# -----------------------------------------------------------------------------
# Path to U-Net PyTorch checkpoint (not stored in git due to file size ~69MB)
MODEL_PATH=unet_spill_best.pth

# Default detection confidence threshold (production baseline: 0.70)
DETECTION_THRESHOLD=0.70

# Path to coastal/land boundary GeoJSON mask (used to filter false positives)
LAND_MASK_PATH=gulf_coast_land.geojson

# -----------------------------------------------------------------------------
# Environmental Forcing & Drift Simulation (Module 2)
# -----------------------------------------------------------------------------
# Path to ocean hydrodynamic & wind forcing NetCDF dataset
ENV_NETCDF_PATH=data/samples/synthetic_env.nc

# Default backward drift search window in hours
DEFAULT_SEARCH_WINDOW_HOURS=6.0

# Number of Lagrangian particles seeded in backward drift reconstruction
DEFAULT_PARTICLE_COUNT=1000

# -----------------------------------------------------------------------------
# AIS Telemetry & Vessel Attribution (Module 3)
# -----------------------------------------------------------------------------
# Default path to NOAA AIS trajectory CSV dataset
AIS_DATA_PATH=data/AIS_178834011589976755_1814-1788340116592.csv

# -----------------------------------------------------------------------------
# Storage & Hand-off Contracts
# -----------------------------------------------------------------------------
# Directory for temporary file uploads
UPLOAD_DIR=uploads

# Working directory for contract output handoffs (detection.json, etc.)
OUTPUT_DIR=.
